# Secrets - set in Render, never commit real values
SAHMK_API_KEY=replace_with_primary_sahmk_key
TASILAB_API_KEY=replace_with_tasilab_key
TASILAB_MARKET_STATUS_CACHE_SECONDS=60

# Provider policy
SAHMK_BASE_URL=https://api.sahmk.sa/api/v1
SAHMK_PLAN=free
SAHMK_LOCAL_DAILY_LIMIT=100
SAHMK_DAILY_SWITCH_LIMIT=95
PROVIDER_SWITCH_ON_DAILY_LIMIT=true
PROVIDER_FALLBACK_ENABLED=true

# V19 runtime policy
PROFIT_ALERT_STEP_PCT=1.0
MARKET_BREADTH_TASILAB_ENABLED=true
MARKET_BREADTH_CACHE_SECONDS=900
MARKET_BREADTH_MIN_COVERAGE=0.65
MARKET_BREADTH_MIN_SAMPLES=80

# WASEEM 30 Early Hunter (non-secret)
WASEEM30_INTERVAL_MINUTES=15
WASEEM30_SCREEN_LIMIT=300
WASEEM30_DETAIL_LIMIT=20
WASEEM30_OPENING_AUCTION_START=09:30
WASEEM30_NEW_ENTRY_END=14:50
